server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # A API rejeita corpos acima de 16 KiB; o nginx corta antes, com folga.
    client_max_body_size 32k;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # O agente (LLM + ferramentas) pode levar dezenas de segundos; o frontend desiste aos 90 s.
        proxy_read_timeout 120s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Arquivos com hash no nome (gerados pelo Vite): cache longo.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
