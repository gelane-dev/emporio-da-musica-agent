# URL base da API FastAPI do agente (backend Python), sem barra final.
# Com valor  -> modo API: a Mel responde de verdade (POST /api/sessions, POST /api/chat).
# Vazio      -> modo demonstrativo: respostas fictícias de src/data, sinalizado na UI.
# Copie para frontend/.env (ignorado pelo git). Não coloque segredos aqui: tudo que
# começa com VITE_ vai para o bundle do navegador.
VITE_API_BASE_URL=http://localhost:8000
