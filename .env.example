# Copie para .env e preencha. O arquivo .env não é versionado.

# Provedor e modelo de IA (trocáveis por configuração)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
# Profundidade do raciocínio: low | medium | high | xhigh | max (padrão: medium)
LLM_EFFORT=medium
# Fallback de recusa no servidor (true/false; só provedor anthropic)
LLM_REFUSAL_FALLBACK=true

# Chave do provedor Groq (padrão)
GROQ_API_KEY=

# Alternativa: provedor Anthropic (LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5-5,
# LLM_MAX_TOKENS=16000)
# ANTHROPIC_API_KEY=

# Data/hora controlada (somente testes e exemplos). Vazio = data/hora real do sistema.
# Formato ISO 8601: 2026-03-25 ou 2026-03-25T10:30 (fuso da loja: America/Campo_Grande)
REFERENCE_DATE=

# Limites do agente
MAX_TOOL_ITERATIONS=6
MAX_HISTORY_TURNS=50

# API HTTP (python -m emporio_agent.api)
# Origens liberadas no CORS, separadas por vírgula (padrão: frontend Vite local)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Máximo de sessões em memória; ao passar, descarta a usada há mais tempo (padrão: 200)
MAX_SESSIONS=200
